# Public site URL — used for canonical URLs, sitemap, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Forms ────────────────────────────────────────────────────────────────
# Consultation, affiliate, careers and Inner Circle forms POST JSON here
# (a CRM webhook, Zapier/Make hook, etc.). Until it is set, forms validate
# but tell visitors plainly that their request was NOT sent.
INQUIRY_WEBHOOK_URL=
# Optional bearer token sent as `Authorization: Bearer <secret>`.
INQUIRY_WEBHOOK_SECRET=

# ── Inner Circle ─────────────────────────────────────────────────────────
# Checkout link (Stripe Payment Link, community platform, etc.). When set,
# every "Join" button goes straight to checkout; otherwise the #join section
# shows a reserve-your-seat form.
NEXT_PUBLIC_INNER_CIRCLE_CHECKOUT_URL=

# ── External links ───────────────────────────────────────────────────────
# Left blank, each renders as plain text instead of a dead link.
NEXT_PUBLIC_MYTRADELINE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_FACEBOOK_URL=
